NODE_ENV=development
PORT=3001
API_PREFIX=api
SWAGGER_PATH=docs
SWAGGER_JSON_PATH=docs/openapi.json
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=blackmint
DATABASE_USERNAME=blackmint
DATABASE_PASSWORD=blackmint
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=backmint-private
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=false
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=replace-with-testnet-contract-id
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
