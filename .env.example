NODE_ENV=development
PORT=3001
API_PREFIX=api
SWAGGER_PATH=docs
SWAGGER_JSON_PATH=docs/openapi.json
CORS_ORIGINS=http://localhost:3001
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20
FINANCIAL_RATE_LIMIT_MAX_REQUESTS=10
PUBLIC_EMBED_RATE_LIMIT_MAX_REQUESTS=30
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=backmint
DATABASE_USERNAME=backmint
DATABASE_PASSWORD=backmint
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_COMPLETED_RETENTION_SECONDS=86400
QUEUE_COMPLETED_RETENTION_COUNT=1000
QUEUE_FAILED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_COUNT=1000
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=backmint-private
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
OBJECT_STORAGE_KMS_KEY_ID=
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=replace-with-testnet-contract-id
WALLET_CHALLENGE_RECIPIENT=backmint-server
NEAR_CONTRACT_VERSION=0.1.0
NEAR_RPC_MAX_ATTEMPTS=3
NEAR_RPC_RETRY_DELAY_MS=100
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
